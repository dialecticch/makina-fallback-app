{
  "name": "makina-fallback-app",
  "version": "0.1.0",
  "description": "Minimal, open-source Makina frontend that reads the chain directly and runs locally.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && vite preview --port 4173 --strictPort",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:fork": "vitest run --project fork",
    "update-abis": "scripts/update-abis.sh",
    "find-start-blocks": "node --env-file-if-exists=.env.local scripts/find-start-blocks.ts",
    "check-implem-ids": "node --env-file-if-exists=.env.local scripts/check-implem-ids.ts",
    "check-factories": "node --env-file-if-exists=.env.local scripts/check-factories.ts",
    "probe-rpcs": "node scripts/probe-rpcs.ts"
  },
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/query-sync-storage-persister": "5.103.2",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-persist-client": "5.103.2",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "viem": "2.56.8",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
